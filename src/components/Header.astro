---
import { SITE_TITLE, GITHUB_REPO, CATEGORIES, CATEGORY_KEYS } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="logo" href="/">
			<span class="logo-bracket">&lt;</span>
			<span class="logo-text">{SITE_TITLE}</span>
			<span class="logo-bracket">/&gt;</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">全部</HeaderLink>
			{
				CATEGORY_KEYS.map((key) => (
					<HeaderLink href={`/blog/${key}/`}>{CATEGORIES[key].label}</HeaderLink>
				))
			}
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		<a class="github-link" href={GITHUB_REPO} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
			<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22">
				<path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.778-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path>
			</svg>
		</a>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding: 0 1.5rem;
		background: rgba(8, 12, 20, 0.85);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: var(--max-width);
		margin: 0 auto;
		height: 3.5rem;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0.1rem;
		text-decoration: none;
		font-family: var(--font-mono);
		font-size: 0.95rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.logo-bracket {
		color: var(--accent);
	}

	.logo-text {
		color: var(--text);
	}

	.logo:hover .logo-text {
		color: var(--accent);
	}

	.internal-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
	}

	.github-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: var(--radius);
		color: var(--text-muted);
		border: 1px solid var(--border);
		transition: all 0.2s ease;
	}

	.github-link:hover {
		color: var(--accent);
		border-color: rgba(34, 211, 238, 0.4);
		background: rgba(34, 211, 238, 0.08);
	}

	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}

		nav {
			flex-wrap: wrap;
			height: auto;
			padding: 0.75rem 0;
		}

		.internal-links {
			order: 3;
			width: 100%;
		}

		.github-link {
			display: none;
		}
	}
</style>
