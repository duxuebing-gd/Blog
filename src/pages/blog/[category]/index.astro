---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import PostList from '../../../components/PostList.astro';
import { CATEGORIES, CATEGORY_KEYS, SITE_TITLE, type Category } from '../../../consts';

export async function getStaticPaths() {
	return CATEGORY_KEYS.map((category) => ({
		params: { category },
	}));
}

const { category } = Astro.params as { category: Category };
const categoryInfo = CATEGORIES[category];

const posts = (await getCollection('blog'))
	.filter((post) => post.data.category === category)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`${categoryInfo.label} | ${SITE_TITLE}`}
			description={categoryInfo.description}
		/>
		<style>
			main {
				width: 960px;
			}
			h1 {
				margin-bottom: 0.25rem;
			}
			.subtitle {
				color: rgb(var(--gray));
				margin-bottom: 2rem;
			}
			.empty {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{categoryInfo.label}</h1>
			<p class="subtitle">{categoryInfo.description}</p>
			{posts.length > 0 ? (
				<PostList posts={posts} showCategory={false} />
			) : (
				<p class="empty">该分类下还没有文章，可以在 <code>src/content/blog/{category}/</code> 目录下添加 Markdown 文件。</p>
			)}
		</main>
		<Footer />
	</body>
</html>
