---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import PostList from '../../../components/PostList.astro';
import { CATEGORIES, CATEGORY_KEYS, SITE_TITLE, type Category } from '../../../consts';

export async function getStaticPaths() {
	return CATEGORY_KEYS.map((category) => ({
		params: { category },
	}));
}

const { category } = Astro.params as { category: Category };
const categoryInfo = CATEGORIES[category];

const posts = (await getCollection('blog'))
	.filter((post) => post.data.category === category)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`${categoryInfo.label} | ${SITE_TITLE}`}
			description={categoryInfo.description}
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>{categoryInfo.label}</h1>
				<p class="subtitle">{categoryInfo.description}</p>
			</div>
			{posts.length > 0 ? (
				<PostList posts={posts} showCategory={false} />
			) : (
				<p class="empty-state">
					// 该分类下还没有文章<br />
					// 在 src/content/blog/{category}/ 目录下添加 Markdown 文件
				</p>
			)}
		</main>
		<Footer />
	</body>
</html>
