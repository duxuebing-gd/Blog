---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE, CATEGORIES, CATEGORY_KEYS } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 5);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<span class="hero-badge">dev.log</span>
				<h1>{SITE_TITLE}</h1>
				<p class="hero-desc">{SITE_DESCRIPTION}</p>
				<div class="terminal">
					<div><span class="prompt">$</span> <span class="cmd">cat README.md</span></div>
					<div class="output">// 技术笔记 · 英语学习 · 生活与阅读</div>
					<div class="output">// 用 Markdown 写作，Git 版本管理，Cloudflare 全球部署</div>
				</div>
			</section>

			<section>
				<h2 class="section-title">Categories</h2>
				<div class="categories">
					{
						CATEGORY_KEYS.map((key) => (
							<a class={`category-card ${key}`} href={`/blog/${key}/`}>
								<div class="card-icon">{CATEGORIES[key].icon}</div>
								<h3>{CATEGORIES[key].label}</h3>
								<p>{CATEGORIES[key].description}</p>
							</a>
						))
					}
				</div>
			</section>

			<section>
				<h2 class="section-title">Recent Posts</h2>
				<PostList posts={recentPosts} />
				<p style="margin-top: 1.5rem">
					<a class="link-arrow" href="/blog/">ls /blog/ →</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
